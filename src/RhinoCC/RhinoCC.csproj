<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48: Rhino 7 (.NET Framework). net7.0-windows: Rhino 8 (.NET Core). -->
    <TargetFrameworks>net48;net7.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>$(NoWarn);NU1701;NU1903</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.0.8</Version>
    <Title>RhinoCC</Title>
    <Company>Alin-Florin Ciu</Company>
    <Description>Blank Rhino plugin for Rhino 7 and Rhino 8.</Description>
    <!-- Portable PDBs so netcoredbg can read them. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default instructions for the agent, kept as a document so they are easy to edit. -->
    <EmbeddedResource Include="Chat\DefaultInstructions.md" LogicalName="DefaultInstructions.md" />
    <EmbeddedResource Include="Chat\panel.ico" LogicalName="panel.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhinoCC.Core\RhinoCC.Core.csproj" />
  </ItemGroup>

  <!-- Each framework references the RhinoCommon that matches its Rhino version. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="RhinoCommon" Version="7.13.21348.13001" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <PackageReference Include="RhinoCommon" Version="8.17.25066.7001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
